{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/build",
      "!!**/coverage",
      "!!**/dist",
      "!!**/generated",
      "!!**/node_modules",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!supabase/.temp",
      "!!supabase/functions/api-v1/fixtures",
      "!!.local-backups",
      "!!supabase/types/database.generated.ts",
      "!!apps/web/app/routeTree.gen.ts",
      "!!apps/web/.tanstack",
      "!!apps/web/dist",
      "!!apps/web/.output"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Textarea", "NativeSelect", "Checkbox", "Radio"],
            "labelComponents": ["Label", "ChoiceField"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
