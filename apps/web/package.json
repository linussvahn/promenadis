{
  "name": "@promenadis/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "serve:production": "node scripts/serve-local-production.mjs",
    "test:local-offline": "node scripts/test-offline-production.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local-auth": "PROMENADIS_LOCAL_AUTH_E2E=1 playwright test tests/local-auth.spec.ts --workers=1",
    "test:local-slice": "node scripts/test-local-slice.mjs",
    "demo:seed": "node scripts/seed-local-demo.mjs",
    "test:local-session-security": "node scripts/test-local-session-security.mjs",
    "test:local-recovery-dispatch": "node scripts/test-local-recovery-dispatch.mjs",
    "typecheck": "react-router typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@promenadis/api-client": "workspace:*",
    "@promenadis/contracts": "workspace:*",
    "@promenadis/i18n": "workspace:*",
    "@promenadis/routing": "workspace:*",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@supabase/supabase-js": "2.115.0",
    "isbot": "5.2.2",
    "maplibre-gl": "5.24.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "8.1.2",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "vite": "8.2.2"
  }
}
